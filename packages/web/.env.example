# Match server.api_prefix; the dev proxy preserves this path when forwarding requests.
VITE_API_PREFIX=/api/v1/docparse
VITE_API_TARGET=http://127.0.0.1:8080
VITE_BASE_PATH=/
# Used only by npm run api:generate; committed types keep normal builds offline from the backend.
DOCPARSE_OPENAPI_URL=http://127.0.0.1:8080/api/v1/docparse/openapi.json
